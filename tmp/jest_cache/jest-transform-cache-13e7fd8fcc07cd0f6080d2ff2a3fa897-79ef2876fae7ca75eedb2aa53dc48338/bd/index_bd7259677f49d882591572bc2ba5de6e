  const updates = {};
  if (avatarUrl) updates.avatarUrl = avatarUrl;
  if (apiKey) {
    const encrypted = CryptoJS.AES.encrypt(apiKey, CRYPTO_SECRET).toString();
    updates.apiKeyEncrypted = encrypted;
  }
  db.get('users').find({
    id: req.user.id
  }).assign(updates).write();
  res.json({
    success: true,
