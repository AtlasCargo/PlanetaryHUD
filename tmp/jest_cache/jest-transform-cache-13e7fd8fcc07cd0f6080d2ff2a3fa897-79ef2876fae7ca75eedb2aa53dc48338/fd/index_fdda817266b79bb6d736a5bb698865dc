app.post('/api/avatar', authMiddleware, async (req, res) => {
  try {
    // Determine which API key to use
    let key = process.env.OPENAI_API_KEY;
    if (req.user.apiKeyEncrypted) {
      const bytes = CryptoJS.AES.decrypt(req.user.apiKeyEncrypted, CRYPTO_SECRET);
      key = bytes.toString(CryptoJS.enc.Utf8);
    }
    if (!key) return res.status(400).json({
      error: 'OpenAI API key not configured'
    });
    // Initialize OpenAI client (classic SDK)
    const openai = new OpenAIApi(new Configuration({
      apiKey: key
    }));
    const model = req.body.model || process.env.IMAGE_MODEL || 'dall-e-4-mini';
    const prompt = req.body.prompt || 'Generate a user avatar';
    // Generate image using new client interface
    const resp = await openai.createImage({
      prompt,
      n: 1,
      size: '256x256',
      model
    });
    const url = resp.data.data[0].url; // openai returns { data: { data: [ { url } ] } } in mocked tests
    // Save to user
    db.get('users').find({
      id: req.user.id
    }).assign({
      avatarUrl: url
    }).write();
    res.json({
      url
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({
      error: err.message
    });
  }
});

